<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_key_vector"
            android:tint="#00E676" />

        <TextView
            android:id="@+id/tvDoorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Door Access Code"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDoorSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter code to proceed to Vault Gate"
        android:textColor="#88FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="18dp" />

    <EditText
        android:id="@+id/etDoorPasscodeInput"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Enter 4-digit code"
        android:textColor="#00E676"
        android:textColorHint="#55FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="numberPassword"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLength="12"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/btnDoorForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Forgot Passcode or Vault Key? Reset"
        android:textColor="#00E676"
        android:textSize="13sp"
        android:padding="4dp"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelDoor"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_input"
            android:text="CANCEL"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

        <Button
            android:id="@+id/btnSubmitDoor"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_button_green"
            android:text="CONFIRM"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

</LinearLayout>
