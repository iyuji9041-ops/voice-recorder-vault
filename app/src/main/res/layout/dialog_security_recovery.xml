<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_help_vector"
            android:tint="#00E676" />

        <TextView
            android:id="@+id/tvRecoveryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Password Recovery"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRecoverySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Answer your security question to reset your password"
        android:textColor="#88FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Question Display / Selection -->
    <TextView
        android:id="@+id/tvQuestionDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Security Question:"
        android:textColor="#00E676"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Answer Input -->
    <EditText
        android:id="@+id/etRecoveryAnswer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Your secret answer"
        android:textColor="#FFFFFF"
        android:textColorHint="#55FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <!-- New Password Input (Shown during reset) -->
    <EditText
        android:id="@+id/etNewPasswordReset"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_glass_input"
        android:hint="New Vault Key / Passcode"
        android:textColor="#00E676"
        android:textColorHint="#55FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="textPassword"
        android:textSize="15sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelRecovery"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_input"
            android:text="CANCEL"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

        <Button
            android:id="@+id/btnSubmitRecovery"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_button_green"
            android:text="VERIFY"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="22dp"
            android:paddingEnd="22dp" />
    </LinearLayout>

</LinearLayout>
