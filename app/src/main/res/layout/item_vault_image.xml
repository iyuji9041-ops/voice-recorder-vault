<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_gallery_item">

    <!-- Image Thumbnail -->
    <ImageView
        android:id="@+id/savedImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Selection Highlight Overlay -->
    <View
        android:id="@+id/vSelectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#5500E676"
        android:visibility="gone" />

    <!-- Video Play Badge Overlay (visible for videos) -->
    <ImageView
        android:id="@+id/ivVideoBadge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_centerInParent="true"
        android:src="@drawable/ic_play_vector"
        app:tint="#FFFFFF"
        android:background="@drawable/bg_glass_input"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- Audio Badge Overlay (visible for audio) -->
    <ImageView
        android:id="@+id/ivAudioBadge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerInParent="true"
        android:src="@drawable/ic_audio_vector"
        app:tint="#00E676"
        android:background="@drawable/bg_glass_input"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Item Title Label (visible on audio / video) -->
    <TextView
        android:id="@+id/tvItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#AA000000"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Selection Checkbox Overlay (top-left) -->
    <ImageView
        android:id="@+id/ivSelectionCheck"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="6dp"
        android:background="@drawable/bg_glass_fab_round"
        android:padding="4dp"
        android:src="@drawable/ic_check_vector"
        app:tint="#FFFFFF"
        android:visibility="gone" />

    <!-- Restore to Downloads Button with clean vector drawable -->
    <ImageView
        android:id="@+id/btnRestore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="6dp"
        android:src="@drawable/ic_download_vector"
        app:tint="#FFFFFF"
        android:background="@drawable/bg_glass_input"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true" />

</RelativeLayout>
