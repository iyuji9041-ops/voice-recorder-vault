<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_note_card"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivIntruderPhoto"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:background="#222222" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/ivIntruderPhoto"
        android:layout_toStartOf="@+id/btnDeleteIntruder"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvIntruderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Failed Unlock Attempt"
            android:textColor="#FF5252"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIntruderTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="30 Sep 2026, 10:30 PM"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnDeleteIntruder"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_delete_vector"
        app:tint="#FF5252"
        android:background="@drawable/bg_glass_input"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"/>

</RelativeLayout>
