<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_dialog"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Password"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_glass_input" 
        android:textColor="#00E676" 
        android:hint="Enter Password"
        android:textColorHint="#88FFFFFF"
        android:inputType="textPassword" 
        android:gravity="center"
        android:textSize="18sp"
        android:maxLength="20" 
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/btnForgotPasswordText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Forgot Key? Reset via Security Question"
        android:textColor="#00E676"
        android:textSize="13sp"
        android:padding="4dp"
        android:layout_marginBottom="18dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/dialogSetButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="CONFIRM"
        android:textColor="#000000"
        android:textStyle="bold"
        android:background="@drawable/bg_glass_button_green" 
        android:gravity="center"/>
</LinearLayout>
