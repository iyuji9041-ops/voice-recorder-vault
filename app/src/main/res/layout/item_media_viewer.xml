<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Zoomable Photo View -->
    <com.my.seekapplication.ZoomableImageView
        android:id="@+id/viewerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Video Playback View -->
    <VideoView
        android:id="@+id/viewerVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Video Touch Overlay for Toggling Controls -->
    <View
        android:id="@+id/videoTouchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Custom Video Controls Overlay -->
    <RelativeLayout
        android:id="@+id/videoControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Center Controls: Rewind 10s, Play/Pause, Forward 10s -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnRewind10"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_input"
                android:padding="12dp"
                android:src="@drawable/ic_rewind_vector"
                android:tint="#FFFFFF"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnVideoPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_record_btn_outer"
                android:padding="18dp"
                android:src="@drawable/ic_play_vector"
                android:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnForward10"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_input"
                android:padding="12dp"
                android:src="@drawable/ic_forward_vector"
                android:tint="#FFFFFF"
                android:layout_marginStart="20dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Video Bottom Seek Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="70dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#88000000"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvVideoCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/videoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="#00E676"
                android:thumbTint="#00E676" />

            <TextView
                android:id="@+id/tvVideoTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#88FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
