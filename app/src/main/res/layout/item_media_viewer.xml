<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Zoomable Photo View -->
    <com.my.seekapplication.ZoomableImageView
        android:id="@+id/viewerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Media3 ExoPlayer Playback View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/viewerPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        app:use_controller="false"
        android:visibility="gone" />

    <!-- Video Touch Overlay for Toggling Controls -->
    <View
        android:id="@+id/videoTouchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Custom Video & Audio Controls Overlay -->
    <RelativeLayout
        android:id="@+id/videoControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Audio Album/Track Info (Visible for audio items) -->
        <LinearLayout
            android:id="@+id/layoutAudioInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_above="@+id/centerControlsLayout"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_audio_vector"
                app:tint="#00E676"
                android:background="@drawable/bg_glass_fab_round"
                android:padding="18dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvAudioViewerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Controls: Rewind 10s, Play/Pause, Forward 10s -->
        <LinearLayout
            android:id="@+id/centerControlsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnRewind10"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_input"
                android:padding="12dp"
                android:src="@drawable/ic_rewind_vector"
                app:tint="#FFFFFF"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnVideoPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_record_btn_outer"
                android:padding="18dp"
                android:src="@drawable/ic_play_vector"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnForward10"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_input"
                android:padding="12dp"
                android:src="@drawable/ic_forward_vector"
                app:tint="#FFFFFF"
                android:layout_marginStart="20dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Bottom Seek Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="70dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#88000000"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvVideoCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/videoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="#00E676"
                android:thumbTint="#00E676" />

            <TextView
                android:id="@+id/tvVideoTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#88FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
